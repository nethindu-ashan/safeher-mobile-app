generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  id               String   @id @default(uuid()) @db.Uuid
  category         String   @db.VarChar(100)
  latitude         Float
  longitude        Float
  incidentDatetime DateTime @map("incident_datetime") @db.Timestamptz(6)
  description      String
  isAnonymous      Boolean  @default(true) @map("is_anonymous")
  status           String   @default("Pending Review") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("incidents")
}

model SupportService {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  type         String   @db.VarChar(50)
  description  String?
  address      String   @db.VarChar(255)
  latitude     Float
  longitude    Float
  phone        String?  @db.VarChar(30)
  openingHours String?  @map("opening_hours") @db.VarChar(100)
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("support_services")
}

model EmergencySOS {
  id          String    @id @default(uuid()) @db.Uuid
  latitude    Float
  longitude   Float
  message     String?   @db.VarChar(255)
  status      String    @default("ACTIVE") @db.VarChar(30)
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@map("emergency_sos")
}
