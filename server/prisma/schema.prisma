generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  id               String   @id @default(uuid()) @db.Uuid
  category         String   @db.VarChar(100)
  latitude         Float
  longitude        Float
  incidentDatetime DateTime @map("incident_datetime") @db.Timestamptz(6)
  description      String
  isAnonymous      Boolean  @default(true) @map("is_anonymous")
  status           String   @default("Pending Review") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evidencePaths String[] @default([]) @map("evidence_paths")

  userId String? @map("user_id") @db.Uuid
  user   UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("incidents")
}

model EmergencySOS {
  id          String    @id @default(uuid()) @db.Uuid
  latitude    Float
  longitude   Float
  message     String?   @db.VarChar(255)
  status      String    @default("ACTIVE") @db.VarChar(30)
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@map("emergency_sos")
}

model NotificationPreference {
  id               String   @id @default(uuid()) @db.Uuid
  nearbyAlerts     Boolean  @default(true) @map("nearby_alerts")
  emergencyAlerts  Boolean  @default(true) @map("emergency_alerts")
  communityUpdates Boolean  @default(true) @map("community_updates")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

enum UserRole {
  USER
  ADMIN
}

model UserProfile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  phone     String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incidents Incident[]

  @@map("user_profiles")
}